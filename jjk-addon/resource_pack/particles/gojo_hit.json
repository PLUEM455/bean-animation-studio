{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:gojo_hit",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 + v.particle_random_1 * 0.12"
      },
      "minecraft:particle_initial_speed": "3 + v.particle_random_2 * 2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 7
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - v.particle_age / v.particle_lifetime)",
          "0.16 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [
            16,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "1.0": "#0046AAFF"
          }
        }
      }
    }
  }
}
