{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:cloud_trail",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards",
        "surface_only": false
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 * (0.75 + v.particle_random_1 * 0.5)"
      },
      "minecraft:particle_initial_speed": "4 * (0.6 + v.particle_random_2 * 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.75 * (1 - v.particle_age / v.particle_lifetime)",
          "0.1"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [
            32,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFF6E5A",
            "1.0": "#00961E1E"
          }
        }
      }
    }
  }
}
