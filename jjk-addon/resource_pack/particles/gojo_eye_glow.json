{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:gojo_eye_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk_particles"
      }
    },
    "components": {
