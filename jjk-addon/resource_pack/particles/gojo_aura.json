{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:gojo_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/jjk_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 16,
        "max_particles": 30
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 1
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          0.45,
          0.95,
          0.3
        ],
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 + v.particle_random_1 * 0.4"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.9,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.09 + 0.05 * v.particle_age / v.particle_lifetime",
          "0.09 + 0.05 * v.particle_age / v.particle_lifetime"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#CC8CDCFF",
            "1.0": "#002A7DE6"
          }
        }
      }
    }
  }
}
