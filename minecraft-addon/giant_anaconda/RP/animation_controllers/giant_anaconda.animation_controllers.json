{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.giant_anaconda.pose": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "stalk": "query.mark_variant == 1"
            },
            {
              "hunt": "query.mark_variant == 2"
            }
          ],
          "blend_transition": 0.5
        },
        "stalk": {
          "animations": [
            "rear_up"
          ],
          "blend_transition": 0.6,
          "transitions": [
            {
              "default": "query.mark_variant == 0"
            },
            {
              "hunt": "query.mark_variant == 2"
            }
          ]
        },
        "hunt": {
          "animations": [
            "hunt"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "default": "query.mark_variant == 0"
            },
            {
              "stalk": "query.mark_variant == 1"
            }
          ]
        }
      }
    }
  }
}
