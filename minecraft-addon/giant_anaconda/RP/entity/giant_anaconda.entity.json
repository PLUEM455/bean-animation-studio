{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "horror:giant_anaconda",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/giant_anaconda"
      },
      "geometry": {
        "default": "geometry.giant_anaconda"
      },
      "animations": {
        "slither": "animation.giant_anaconda.slither",
        "idle": "animation.giant_anaconda.idle",
        "tongue": "animation.giant_anaconda.tongue",
        "rear_up": "animation.giant_anaconda.rear_up",
        "hunt": "animation.giant_anaconda.hunt",
        "pose": "controller.animation.giant_anaconda.pose",
        "strike": "animation.giant_anaconda.strike",
        "flinch": "animation.giant_anaconda.flinch",
        "death": "animation.giant_anaconda.death"
      },
      "scripts": {
        "animate": [
          "idle",
          "tongue",
          {
            "slither": "math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0)"
          },
          "pose",
          {
            "death": "!query.is_alive"
          }
        ]
      },
      "render_controllers": [
        "controller.render.giant_anaconda"
      ],
      "spawn_egg": {
        "base_color": "#0c0c14",
        "overlay_color": "#ffd700"
      }
    }
  }
}
