{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "horror:giant_anaconda",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "horror:wander": {
        "minecraft:mark_variant": {
          "value": 0
        },
        "minecraft:movement": {
          "value": 0.22
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6
        },
        "minecraft:entity_sensor": {
          "sensor_range": 20,
          "relative_range": false,
          "minimum_count": 1,
          "event_filters": {
            "test": "is_family",
            "subject": "other",
            "value": "player"
          },
          "event": "horror:start_stalk"
        }
      },
      "horror:stalking": {
        "minecraft:mark_variant": {
          "value": 1
        },
        "minecraft:movement": {
          "value": 0.0
        },
        "minecraft:behavior.look_at_player": {
          "priority": 1,
          "look_distance": 32,
          "probability": 1.0
        },
        "minecraft:timer": {
          "looping": false,
          "time": [
            5,
            9
          ],
          "randomInterval": true,
          "time_down_event": {
            "event": "horror:start_hunt"
          }
        }
      },
      "horror:hunting": {
        "minecraft:mark_variant": {
          "value": 2
        },
        "minecraft:movement": {
          "value": 0.32
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 32,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 32
            }
          ]
        },
        "minecraft:break_blocks": {
          "breakable_blocks": [
            "minecraft:oak_leaves",
            "minecraft:spruce_leaves",
            "minecraft:birch_leaves",
            "minecraft:jungle_leaves",
            "minecraft:acacia_leaves",
            "minecraft:dark_oak_leaves",
            "minecraft:mangrove_leaves",
            "minecraft:cherry_leaves",
            "minecraft:azalea_leaves",
            "minecraft:glass",
            "minecraft:glass_pane",
            "minecraft:short_grass",
            "minecraft:tall_grass",
            "minecraft:fern",
            "minecraft:vine",
            "minecraft:web"
          ]
        }
      },
      "horror:despawn": {
        "minecraft:instant_despawn": {}
      },
      "horror:skin_black": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "horror:skin_red": {
        "minecraft:variant": {
          "value": 1
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "anaconda",
          "monster",
          "horror"
        ]
      },
      "minecraft:health": {
        "value": 120,
        "max": 120
      },
      "minecraft:collision_box": {
        "width": 1.0,
        "height": 0.5
      },
      "minecraft:knockback_resistance": {
        "value": 0.8
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 40
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.climb": {
        "can_path_over_water": true
      },
      "minecraft:can_climb": {},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:attack": {
        "damage": 16,
        "effect_name": "poison",
        "effect_duration": 10
      },
      "minecraft:ambient_sound_interval": {
        "value": 10,
        "range_min": 6,
        "range_max": 14,
        "event_name": "ambient"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_mark_variant",
                    "subject": "self",
                    "operator": "!=",
                    "value": 2
                  }
                ]
              },
              "event": "horror:start_hunt"
            }
          },
          {
            "on_damage": {
              "event": "horror:on_hurt"
            }
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.2,
        "track_target": true,
        "on_attack": {
          "event": "horror:on_bite"
        }
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/giant_anaconda.json"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "horror:wander"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 3,
                "add": {
                  "component_groups": [
                    "horror:skin_black"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "horror:skin_red"
                  ]
                }
              }
            ]
          }
        ]
      },
      "horror:spawn_red": {
        "add": {
          "component_groups": [
            "horror:wander",
            "horror:skin_red"
          ]
        }
      },
      "horror:spawn_black": {
        "add": {
          "component_groups": [
            "horror:wander",
            "horror:skin_black"
          ]
        }
      },
      "horror:start_stalk": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "horror:wander"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "horror:stalking"
              ]
            }
          },
          {
            "queue_command": {
              "command": "playsound giant_anaconda.hiss @a[r=32] ~ ~ ~ 1 1"
            }
          }
        ]
      },
      "horror:start_hunt": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "horror:wander",
                "horror:stalking"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "horror:hunting"
              ]
            }
          },
          {
            "queue_command": {
              "command": [
                "playsound giant_anaconda.roar @a[r=48] ~ ~ ~ 1 1",
                "playanimation @s animation.giant_anaconda.flinch flinch 0.1",
                "camerashake add @a[r=24] 0.35 1.5 rotational"
              ]
            }
          }
        ]
      },
      "horror:on_bite": {
        "queue_command": {
          "command": [
            "playsound giant_anaconda.bite @a[r=24] ~ ~ ~ 1 1",
            "playanimation @s animation.giant_anaconda.strike strike 0.05",
            "camerashake add @a[r=5] 0.7 0.35 positional"
          ]
        }
      },
      "horror:on_hurt": {
        "queue_command": {
          "command": "playanimation @s animation.giant_anaconda.flinch flinch 0.05"
        }
      },
      "horror:vanish": {
        "sequence": [
          {
            "queue_command": {
              "command": "playsound giant_anaconda.vanish @a[r=32] ~ ~ ~ 1 1"
            }
          },
          {
            "add": {
              "component_groups": [
                "horror:despawn"
              ]
            }
          }
        ]
      }
    }
  }
}
